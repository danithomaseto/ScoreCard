# Copie este arquivo para ".env" e preencha. O ".env" nunca deve ser commitado.

# URL do painel publicado no Vercel (sem barra no final)
DASHBOARD_URL=https://seu-projeto.vercel.app

# Mesmo valor configurado na variavel de ambiente APP_TOKEN do projeto Vercel
APP_TOKEN=

# Intervalo (segundos) entre verificacoes de novas tarefas no painel
POLL_INTERVAL_SECONDS=5

# Operacao: Hugo Boss
HUGO_BOSS_USERNAME=
HUGO_BOSS_PASSWORD=

# Opcional: pasta para guardar uma copia local do relatorio antes do
# upload para o painel. Se nao definir, usa uma pasta temporaria do SO.
# DOWNLOAD_DIR=C:\Users\seu.usuario\Desktop
