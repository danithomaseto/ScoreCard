# Copie este arquivo para ".env" e preencha com as credenciais reais.
# O ".env" NUNCA deve ser commitado (ja esta no .gitignore).

# Operacao: Hugo Boss
HUGO_BOSS_USERNAME=
HUGO_BOSS_PASSWORD=

# Opcional: pasta onde o relatorio baixado sera salvo.
# Se nao definir, usa a Area de Trabalho do usuario atual.
# DOWNLOAD_DIR=C:\Users\seu.usuario\Desktop
