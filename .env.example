# Copie este arquivo para ".env" e preencha. O ".env" nunca deve ser commitado.

# Necessario apenas para rodar agent.py (painel web). Nao e usado pelo
# app.py local.
# URL do painel publicado no Vercel (pasta panel/), sem barra no final.
DASHBOARD_URL=https://seu-projeto.vercel.app
# Mesmo valor configurado na variavel de ambiente APP_TOKEN do projeto Vercel.
APP_TOKEN=
# Intervalo (segundos) entre verificacoes de novas tarefas no painel.
POLL_INTERVAL_SECONDS=5

# Mesmo usuario/senha usado em todas as operacoes (Hugo Boss, Hughes,
# Swa, Nike/Fisia, Sumup, Rede, JCB, Lego, SpaceX, HPE, Armani, ABB).
DHL_USERNAME=
DHL_PASSWORD=

# Opcional: forca TODAS as operacoes a salvar numa unica pasta fixa,
# ignorando a subpasta por operacao no SharePoint. Deixe comentado no uso
# normal - cada operacao ja salva sozinha na sua subpasta dentro de:
# C:\Users\danitho2\OneDrive - DPDHL\CLM GESTÃO CONJUNTA - Automação Score
# DOWNLOAD_DIR=C:\Users\danitho2\Desktop
